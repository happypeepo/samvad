# Node
node_modules/
npm-debug.log*

# Vite build output
web/dist/

# Android — build artifacts (regenerated by Gradle, don't belong in VCS)
android/.gradle/
web/android/.gradle/
web/android/local.properties
web/android/app/build/
web/android/build/
web/android/capacitor-cordova-android-plugins/build/
web/android/**/*.iml
web/android/.idea/
web/android/app/release/

# Release signing — NEVER commit. Losing this file just means regenerating
# a new key (and re-signing future releases under a new identity); leaking
# it is unrecoverable — anyone with it can sign updates as this app.
web/android/keystore.properties
web/android/app/*.jks
web/android/app/*.keystore

# OS / editor cruft
.DS_Store
*.log
.claude/
